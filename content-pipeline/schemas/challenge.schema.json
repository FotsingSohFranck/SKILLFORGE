{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "challenge.schema.json",
  "title": "Défi de code (authoré)",
  "type": "object",
  "additionalProperties": false,
  "required": ["node", "title", "statement", "solution", "keyPoints"],
  "properties": {
    "node": { "type": "string", "minLength": 1, "description": "slug du nœud rattaché" },
    "lesson": { "type": "string", "description": "slug de leçon (optionnel)" },
    "title": { "type": "string", "minLength": 1 },
    "statement": { "type": "string", "minLength": 1 },
    "skeleton": { "type": "string" },
    "solution": { "type": "string", "minLength": 1 },
    "keyPoints": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "points clés attendus pour la validation (comparaison textuelle)"
    },
    "language": { "type": "string" }
  }
}
