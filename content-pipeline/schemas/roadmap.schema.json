{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "roadmap.schema.json",
  "title": "Roadmap pivot (authoré)",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "title", "phases", "nodes"],
  "properties": {
    "slug": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "kind": { "enum": ["TRACK", "CERTIFICATION"] },
    "position": { "type": "integer" },
    "certification": { "$ref": "#/definitions/certification" },
    "phases": { "type": "array", "items": { "$ref": "#/definitions/phase" } },
    "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/definitions/edge" } }
  },
  "definitions": {
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "position": { "type": "integer" }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "title"],
      "properties": {
        "slug": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "phase": { "type": "string" },
        "importance": { "enum": ["CORE", "RECOMMENDED", "OPTIONAL"] },
        "estimatedMinutes": { "type": "integer", "minimum": 0 },
        "position": { "type": "integer" },
        "examDomains": { "type": "array", "items": { "$ref": "#/definitions/nodeExamDomain" } }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["PREREQ"] }
      }
    },
    "certification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "examFormat", "durationMinutes", "domains"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "examFormat": { "enum": ["MCQ", "PRACTICAL"] },
        "durationMinutes": { "type": "integer", "minimum": 1 },
        "passingScore": { "type": "number" },
        "domains": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/examDomain" } }
      }
    },
    "examDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "weight": { "type": "number" },
        "position": { "type": "integer" }
      }
    },
    "nodeExamDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain"],
      "properties": {
        "domain": { "type": "string", "minLength": 1 },
        "weight": { "type": "number" }
      }
    }
  }
}
