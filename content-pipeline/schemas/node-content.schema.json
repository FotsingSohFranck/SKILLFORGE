{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "node-content.schema.json",
  "title": "Contenu d'un nœud (authoré)",
  "type": "object",
  "additionalProperties": false,
  "required": ["node", "lessons"],
  "properties": {
    "node": { "type": "string", "minLength": 1, "description": "slug du nœud (dans la roadmap)" },
    "lessons": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/lesson" } }
  },
  "definitions": {
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "title", "sections"],
      "properties": {
        "slug": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "position": { "type": "integer" },
        "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/section" } }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "position"],
      "properties": {
        "type": { "enum": ["CONCEPT", "DIAGRAM", "CODE", "EXERCISE", "QUIZ", "IMAGE"] },
        "position": { "type": "integer" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "codeLanguage": { "type": "string" },
        "diagramFormat": { "enum": ["SVG", "MERMAID"] },
        "solution": { "type": "string" },
        "quizRef": { "type": "string", "description": "réf locale d'un quiz (quizzes/<ref>.json)" }
      }
    }
  }
}
