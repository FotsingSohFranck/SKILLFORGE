<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.skillforge</groupId>
        <artifactId>skillforge-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>app</artifactId>
    <name>SkillForge :: app</name>
    <description>Module d'assemblage : main Spring Boot, config runtime, sécurité, migrations, OpenAPI.</description>

    <dependencies>
        <!-- Contextes bornés -->
        <dependency><groupId>dev.skillforge</groupId><artifactId>common</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>dev.skillforge</groupId><artifactId>iam</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>dev.skillforge</groupId><artifactId>catalogue</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>dev.skillforge</groupId><artifactId>contenu</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>dev.skillforge</groupId><artifactId>apprentissage</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>dev.skillforge</groupId><artifactId>evaluation</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>dev.skillforge</groupId><artifactId>gamification</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>dev.skillforge</groupId><artifactId>analytics</artifactId><version>${project.version}</version></dependency>

        <!-- Stack runtime réactive -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-r2dbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Driver R2DBC (runtime) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>r2dbc-postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Migrations Flyway via JDBC (démarrage uniquement).
             En Boot 4, l'auto-configuration Flyway vit dans le module `spring-boot-flyway`,
             apporté par ce starter (avec `spring-boot-jdbc`). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Documentation OpenAPI -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>skillforge</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
