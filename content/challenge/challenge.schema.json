{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://skillforge.dev/schemas/challenge.schema.json",
  "title": "Final Challenge — scénario (pivot)",
  "description": "Définition immuable d'un scénario de Final Challenge (ADR-0009 / SF-92a). Importé via POST /api/v1/final-challenges/scenarios/import ; chaque import crée une nouvelle version. Les formats d'interaction v1 sont discrets et auto-notables.",
  "type": "object",
  "required": [
    "scenarioKey", "nodeId", "title", "objective", "briefing",
    "competencies", "competencyWeights", "passThreshold", "renforceThreshold",
    "initialNodeId", "nodes"
  ],
  "additionalProperties": false,
  "properties": {
    "scenarioKey": { "type": "string", "minLength": 1, "description": "Clé stable lisible (slug)." },
    "nodeId": { "type": "string", "format": "uuid", "description": "Nœud de fin rattaché (référence souple)." },
    "title": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "briefing": { "type": "string", "minLength": 1 },
    "competencies": {
      "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true
    },
    "competencyWeights": {
      "type": "object",
      "description": "Pondération par compétence ; la somme doit valoir 100.",
      "additionalProperties": { "type": "integer", "minimum": 1 }
    },
    "passThreshold": { "type": "integer", "minimum": 1, "maximum": 100 },
    "renforceThreshold": { "type": "integer", "minimum": 1, "maximum": 99 },
    "initialNodeId": { "type": "string", "minLength": 1 },
    "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/node" } },
    "criticalConditions": { "type": "array", "items": { "$ref": "#/definitions/criticalCondition" } },
    "mode": {
      "type": "string",
      "enum": ["FORMATIF", "CERTIFICATIF"],
      "description": "Mode d'évaluation (SF-92e). Absent ⇒ FORMATIF. Les règles associées sont annoncées avant lancement."
    }
  },
  "definitions": {
    "node": {
      "type": "object",
      "required": ["id", "title", "terminal"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "context": { "type": "string" },
        "event": { "type": "string" },
        "interactionType": {
          "type": "string",
          "enum": ["SINGLE_CHOICE", "MULTI_CHOICE", "ORDERING", "DIAGNOSIS"]
        },
        "competencies": { "type": "array", "items": { "type": "string" } },
        "choices": { "type": "array", "items": { "$ref": "#/definitions/choice" } },
        "transitions": { "type": "array", "items": { "$ref": "#/definitions/transition" } },
        "terminal": { "type": "boolean" }
      }
    },
    "choice": {
      "type": "object",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "competencyScores": { "type": "object", "additionalProperties": { "type": "integer" } },
        "effects": { "type": "array", "items": { "$ref": "#/definitions/effect" } },
        "rationale": { "type": "string" }
      }
    },
    "effect": {
      "type": "object",
      "required": ["variable", "op", "value"],
      "additionalProperties": false,
      "properties": {
        "variable": { "type": "string", "minLength": 1 },
        "op": { "type": "string", "enum": ["SET", "INCREASE", "DECREASE"] },
        "value": { "type": "integer" }
      }
    },
    "transition": {
      "type": "object",
      "required": ["nextNodeId"],
      "additionalProperties": false,
      "properties": {
        "whenState": { "type": "string", "description": "Condition sur l'état (interprétée par le moteur SF-92a-2). 'default' ou vide = transition par défaut." },
        "nextNodeId": { "type": "string", "minLength": 1 }
      }
    },
    "criticalCondition": {
      "type": "object",
      "required": ["id", "description"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "whenState": { "type": "string" }
      }
    }
  }
}
