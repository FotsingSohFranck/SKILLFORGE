<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.skillforge</groupId>
        <artifactId>skillforge-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>lab</artifactId>
    <name>SkillForge :: lab</name>
    <description>Contexte borné Lab (évaluation pratique par conteneur). ADR-0008 / SF-91. SF-91a : modèle + ports (pas d'orchestration).</description>
    <dependencies>
        <dependency><groupId>dev.skillforge</groupId><artifactId>common</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webflux</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-r2dbc</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>

        <!-- Terminal interactif (SF-91f) : client API Docker (exec Tty) pour un vrai PTY côté serveur.
             Transport zerodep : support socket Unix auto-suffisant, non couplé a la version httpclient5
             imposee par le BOM Spring Boot 4 (la httpclient5 5.6.x casse le socket Unix de docker-java 3.4). -->
        <dependency><groupId>com.github.docker-java</groupId><artifactId>docker-java-core</artifactId><version>3.4.0</version></dependency>
        <dependency><groupId>com.github.docker-java</groupId><artifactId>docker-java-transport-zerodep</artifactId><version>3.4.0</version></dependency>

        <!-- Tests d'intégration : Testcontainers (PostgreSQL 18) + drivers (prêts pour SF-91b+) -->
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-testcontainers</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.testcontainers</groupId><artifactId>testcontainers-junit-jupiter</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.testcontainers</groupId><artifactId>testcontainers-postgresql</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.postgresql</groupId><artifactId>r2dbc-postgresql</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>test</scope></dependency>
    </dependencies>
</project>
